# The app binds to loopback by default; open it at http://localhost:3000.
VMTECH_PORT=3000

# VMTech Lee profiles map to local Ollama models; these are profile aliases,
# not separately trained weights. The Lee 1.0 tag falls back to OLLAMA_MODEL.
VMTECH_LEE_1_MODEL=qwen3.5:4b
VMTECH_LEE_2_LITE_MODEL=qwen3.5:9b
VMTECH_LEE_2_PRO_MODEL=qwen3.5:27b

# Legacy fallback for Lee 1.0 when VMTECH_LEE_1_MODEL is unset.
OLLAMA_MODEL=qwen3.5:4b

# Keep context and concurrency modest for typical home hardware.
OLLAMA_NUM_CTX=6144
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT_MS=300000
# Keep the model loaded in RAM between requests for faster follow-up responses.
OLLAMA_KEEP_ALIVE=30m

# The Compose stack exposes the app only at 127.0.0.1 by default.
# Disable provider settings if this instance will be shared with untrusted users.
VMTECH_ALLOW_PROVIDER_SETTINGS=true
